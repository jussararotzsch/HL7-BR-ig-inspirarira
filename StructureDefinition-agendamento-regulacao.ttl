     fhir:StructureDefinition.snapshot.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "Appointment" ] ;
       fhir:ElementDefinition.path [ fhir:value "Appointment" ] ;
       fhir:ElementDefinition.short [ fhir:value "Agendamento de Regulação Assistencial" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Agendamento resultante da regulação. Só DEVE ser criado quando houver proposta de data, local e serviço. Os estados booked, fulfilled, cancelled e noshow substituem os slices event:booked, event:attended, event:cancelled e event:absence do RIRA." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "Appointment" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "*" ]
       ] ;
       fhir:ElementDefinition.constraint [
         fhir:index 0 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "app-2" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Either start and end are specified, or neither" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "start.exists() = end.exists()" ] ;
         fhir:ElementDefinition.constraint.xpath [ fhir:value "((exists(f:start) and exists(f:end)) or (not(exists(f:start)) and not(exists(f:end))))" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "https://br-core.saude.gov.br/fhir/StructureDefinition/br-core-appointment" ;
           fhir:link <https://br-core.saude.gov.br/fhir/StructureDefinition/br-core-appointment>
         ]
       ], [
         fhir:index 1 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "app-3" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Only proposed or cancelled appointments can be missing start/end dates" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "(start.exists() and end.exists()) or (status in ('proposed' | 'cancelled' | 'waitlist'))" ] ;
         fhir:ElementDefinition.constraint.xpath [ fhir:value "((exists(f:start) and exists(f:end)) or (f:status/@value='proposed') or (f:status/@value='cancelled') or (f:status/@value='waitlist'))" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "https://br-core.saude.gov.br/fhir/StructureDefinition/br-core-appointment" ;
           fhir:link <https://br-core.saude.gov.br/fhir/StructureDefinition/br-core-appointment>
         ]
       ], [
         fhir:index 2 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "app-4" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Cancelation reason is only used for appointments that have been cancelled, or no-show" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "Appointment.cancelationReason.exists() implies (Appointment.status='no-show' or Appointment.status='cancelled')" ] ;
         fhir:ElementDefinition.constraint.xpath [ fhir:value "not(exists(f:cancellationReason)) or f:status/@value=('no-show', 'cancelled')" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "https://br-core.saude.gov.br/fhir/StructureDefinition/br-core-appointment" ;
           fhir:link <https://br-core.saude.gov.br/fhir/StructureDefinition/br-core-appointment>
         ]
       ], [
         fhir:index 3 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "dom-2" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "If the resource is contained in another resource, it SHALL NOT contain nested Resources" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "contained.contained.empty()" ] ;
         fhir:ElementDefinition.constraint.xpath [ fhir:value "not(parent::f:contained and f:contained)" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://hl7.org/fhir/StructureDefinition/DomainResource" ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/DomainResource>
         ]
       ], [
         fhir:index 4 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "dom-3" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "If the resource is contained in another resource, it SHALL be referred to from elsewhere in the resource or SHALL refer to the containing resource" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "contained.where((('#'+id in (%resource.descendants().reference | %resource.descendants().as(canonical) | %resource.descendants().as(uri) | %resource.descendants().as(url))) or descendants().where(reference = '#').exists() or descendants().where(as(canonical) = '#').exists() or descendants().where(as(canonical) = '#').exists()).not()).trace('unmatched', id).empty()" ] ;
         fhir:ElementDefinition.constraint.xpath [ fhir:value "not(exists(for $id in f:contained/*/f:id/@value return $contained[not(parent::*/descendant::f:reference/@value=concat('#', $contained/*/id/@value) or descendant::f:reference[@value='#'])]))" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://hl7.org/fhir/StructureDefinition/DomainResource" ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/DomainResource>
         ]
       ], [
         fhir:index 5 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "dom-4" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "If a resource is contained in another resource, it SHALL NOT have a meta.versionId or a meta.lastUpdated" ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "contained.meta.versionId.empty() and contained.meta.lastUpdated.empty()" ] ;
         fhir:ElementDefinition.constraint.xpath [ fhir:value "not(exists(f:contained/*/f:meta/f:versionId)) and not(exists(f:contained/*/f:meta/f:lastUpdated))" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://hl7.org/fhir/StructureDefinition/DomainResource" ;
           fhir:link <http://hl7.org/fhir/StructureDefinition/DomainResource>
         ]
