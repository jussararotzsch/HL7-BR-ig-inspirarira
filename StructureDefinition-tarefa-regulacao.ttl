       fhir:ElementDefinition.short [ fhir:value "Prioridade Regulatória" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Classe, escore e fatores componentes da prioridade clínica atribuída pela regulação. Task.priority (request-priority) só expressa urgência operacional e não comporta classe de protocolo, escore nem fatores de equidade." ] ;
