       fhir:ElementDefinition.path [ fhir:value "Task.extension" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "dataEntradaFila" ] ;
       fhir:ElementDefinition.short [ fhir:value "Data de Entrada na Fila" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Momento em que o pedido se tornou elegível e entrou na fila regulada. Preservada quando uma reserva expira e a tarefa volta à fila, ou quando uma nova etapa substitui a anterior (seção 7.3 do guia do GT). Difere de ServiceRequest.authoredOn (autoria do pedido) e de Task.authoredOn (criação da etapa)." ] ;
