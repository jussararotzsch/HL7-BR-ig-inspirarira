  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "Task" ] ;
       fhir:ElementDefinition.path [ fhir:value "Task" ] ;
       fhir:ElementDefinition.short [ fhir:value "Tarefa de Regulação Assistencial" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Etapa de trabalho regulatório sobre uma Requisição de Regulação: regulação do acesso (qualificação, priorização, alocação e agendamento), autorização regulatória, reavaliação, recurso e contrarreferência. É onde a decisão regulatória acontece, com dimensão, resultado, motivo, responsável e protocolo. Substitui os slices de Composition.event do RIRA." ] ;
       fhir:ElementDefinition.constraint [
         fhir:index 0 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "tr-1" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Tarefa rejeitada DEVE informar o motivo (statusReason) e ao menos uma dimensão avaliada (output). Negativa sem motivo computável não permite recurso nem análise de equidade." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "status = 'rejected' implies (statusReason.exists() and output.exists())" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://fhir.hsl.org.br/ig/inspirarira/StructureDefinition/tarefa-regulacao" ;
           fhir:link <http://fhir.hsl.org.br/ig/inspirarira/StructureDefinition/tarefa-regulacao>
         ]
       ], [
         fhir:index 1 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "tr-2" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Tarefa com situação 'agendado' DEVE apontar o Appointment em output." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "businessStatus.coding.where(code = 'agendado').exists() implies output.value.ofType(Reference).where(reference.startsWith('Appointment/')).exists()" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://fhir.hsl.org.br/ig/inspirarira/StructureDefinition/tarefa-regulacao" ;
           fhir:link <http://fhir.hsl.org.br/ig/inspirarira/StructureDefinition/tarefa-regulacao>
         ]
       ], [
         fhir:index 2 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "tr-3" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Tarefa de autorização concluída ou rejeitada DEVE registrar a decisão em output (type = decisao)." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "(code.coding.where(code = 'autorizacao').exists() and (status = 'completed' or status = 'rejected')) implies output.where(type.coding.where(code = 'decisao').exists()).exists()" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://fhir.hsl.org.br/ig/inspirarira/StructureDefinition/tarefa-regulacao" ;
           fhir:link <http://fhir.hsl.org.br/ig/inspirarira/StructureDefinition/tarefa-regulacao>
         ]
       ], [
         fhir:index 3 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "tr-4" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Vaga zero DEVE ter motivo (statusReason) e justificativa em note." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "businessStatus.coding.where(code = 'vaga-zero').exists() implies (statusReason.exists() and note.exists())" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://fhir.hsl.org.br/ig/inspirarira/StructureDefinition/tarefa-regulacao" ;
           fhir:link <http://fhir.hsl.org.br/ig/inspirarira/StructureDefinition/tarefa-regulacao>
         ]
       ], [
         fhir:index 4 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "tr-5" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Tarefa com leito reservado DEVE apontar a InternacaoRegulada em output." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "businessStatus.coding.where(code = 'leito-reservado').exists() implies output.value.ofType(Reference).where(reference.startsWith('Encounter/')).exists()" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://fhir.hsl.org.br/ig/inspirarira/StructureDefinition/tarefa-regulacao" ;
           fhir:link <http://fhir.hsl.org.br/ig/inspirarira/StructureDefinition/tarefa-regulacao>
         ]
       ]
