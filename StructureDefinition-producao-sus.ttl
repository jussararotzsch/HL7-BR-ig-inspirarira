       fhir:ElementDefinition.short [ fhir:value "Registro de Produção SUS (BPA-I, RAAS, APAC, AIH)" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Apresentação da produção ao SIA/SUS ou SIH/SUS depois da execução do cuidado. Cobre BPA-I e RAAS (sem autorização prévia) e a produção de APAC e AIH (ligada à autorização emitida). Cada item aponta para o Encounter executado." ] ;
       fhir:ElementDefinition.constraint [
         fhir:index 0 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "pr-1" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Produção de APAC ou AIH DEVE informar o número da autorização em insurance.preAuthRef. BPA-I e RAAS dispensam autorização prévia." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "subType.coding.where(code = 'apac' or code = 'aih').exists() implies insurance.preAuthRef.exists()" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://fhir.hsl.org.br/ig/inspirarira/StructureDefinition/producao-sus" ;
