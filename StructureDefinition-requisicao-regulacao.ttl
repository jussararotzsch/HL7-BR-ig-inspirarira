  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "ServiceRequest" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest" ] ;
       fhir:ElementDefinition.short [ fhir:value "Requisição de Regulação Assistencial" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Pedido clínico persistente submetido à regulação do acesso. Registra o que é solicitado, por quê, com que prioridade e com que apoio clínico, independentemente do canal de financiamento. Substitui BRRequisicaoRegulacaoAssistencial do RIRA." ] ;
       fhir:ElementDefinition.constraint [
         fhir:index 0 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "rr-1" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Todo pedido regulado DEVE informar a indicação clínica (reasonCode ou reasonReference). Pedido sem indicação não é regulável de forma segura." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "reasonCode.exists() or reasonReference.exists()" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://fhir.hsl.org.br/ig/inspirarira/StructureDefinition/requisicao-regulacao" ;
           fhir:link <http://fhir.hsl.org.br/ig/inspirarira/StructureDefinition/requisicao-regulacao>
         ]
       ]
     ], [
       fhir:index 1 ;
       fhir:Element.id [ fhir:value "ServiceRequest.contained" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.contained" ] ;
       fhir:ElementDefinition.short [ fhir:value "Recursos contidos" ]
     ], [
       fhir:index 2 ;
       fhir:Element.id [ fhir:value "ServiceRequest.extension" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.extension" ] ;
       fhir:ElementDefinition.short [ fhir:value "Extensões adicionais" ]
     ], [
       fhir:index 3 ;
       fhir:Element.id [ fhir:value "ServiceRequest.identifier" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.identifier" ] ;
       fhir:ElementDefinition.short [ fhir:value "Identificador persistente da solicitação" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Acompanha qualificação, autorização, fila, agendamento, execução e desfecho. NÃO reutilizar número de APAC, AIH ou guia como único identificador. No RIRA este elemento era 0..0." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 4 ;
       fhir:Element.id [ fhir:value "ServiceRequest.instantiatesCanonical" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.instantiatesCanonical" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Para OCI, DEVE apontar o ProtocoloOCI (url|versao)." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 5 ;
       fhir:Element.id [ fhir:value "ServiceRequest.status" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.status" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Controla só a vigência clínica do pedido: draft, active, on-hold, revoked, completed, entered-in-error. NÃO DEVE carregar estados de fila, autorização ou agendamento; esses ficam em TarefaRegulacao.businessStatus. O ValueSet próprio BRStatusRequisicaoRegulacaoAssistencial deixa de ser usado." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 6 ;
       fhir:Element.id [ fhir:value "ServiceRequest.intent" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.intent" ] ;
       fhir:ElementDefinition.comment [ fhir:value "order para o pedido vigente. Usa request-intent padrão; o ValueSet próprio BRIntencaoRegulacao deixa de ser usado." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 7 ;
       fhir:Element.id [ fhir:value "ServiceRequest.category" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.category" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 8 ;
       fhir:Element.id [ fhir:value "ServiceRequest.priority" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.priority" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 9 ;
       fhir:Element.id [ fhir:value "ServiceRequest.code" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.code" ] ;
       fhir:ElementDefinition.comment [ fhir:value "SIGTAP para a regulação SUS. Outras terminologias (TUSS, SNOMED CT) PODEM ser usadas com ConceptMap governado. Atenção: BRProcedimentosNacionais, herdado do BR-Core, enumera TUSS-22 no pacote de terminologia, enquanto o ValueSet homônimo da RNDS é SIGTAP." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "preferred" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "https://terminologia.saude.gov.br/fhir/ValueSet/BRTabelaSUS" ;
           fhir:link <https://terminologia.saude.gov.br/fhir/ValueSet/BRTabelaSUS>
         ]
       ]
     ], [
       fhir:index 10 ;
       fhir:Element.id [ fhir:value "ServiceRequest.subject" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.subject" ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Reference" ] ;
         fhir:ElementDefinition.type.targetProfile [
           fhir:value "https://br-core.saude.gov.br/fhir/StructureDefinition/br-core-patient" ;
           fhir:index 0 ;
           fhir:link <https://br-core.saude.gov.br/fhir/StructureDefinition/br-core-patient>
         ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 11 ;
       fhir:Element.id [ fhir:value "ServiceRequest.encounter" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.encounter" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Contexto em que o pedido nasceu (seção 5 do guia do GT). No RIRA era 0..0." ] ;
       fhir:ElementDefinition.type [
         fhir:index 0 ;
         fhir:ElementDefinition.type.code [ fhir:value "Reference" ] ;
         fhir:ElementDefinition.type.targetProfile [
           fhir:value "https://br-core.saude.gov.br/fhir/StructureDefinition/br-core-encounter" ;
           fhir:index 0 ;
           fhir:link <https://br-core.saude.gov.br/fhir/StructureDefinition/br-core-encounter>
         ]
       ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 12 ;
       fhir:Element.id [ fhir:value "ServiceRequest.occurrence[x]" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.occurrence[x]" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Prazo, janela ou periodicidade clínica. Não confundir com a prioridade relativa na fila, que fica na TarefaRegulacao." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 13 ;
       fhir:Element.id [ fhir:value "ServiceRequest.authoredOn" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.authoredOn" ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 14 ;
       fhir:Element.id [ fhir:value "ServiceRequest.requester" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.requester" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 15 ;
       fhir:Element.id [ fhir:value "ServiceRequest.performerType" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.performerType" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "extensible" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "https://terminologia.saude.gov.br/fhir/ValueSet/BROcupacao" ;
           fhir:link <https://terminologia.saude.gov.br/fhir/ValueSet/BROcupacao>
         ]
       ]
     ], [
       fhir:index 16 ;
       fhir:Element.id [ fhir:value "ServiceRequest.performer" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.performer" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 17 ;
       fhir:Element.id [ fhir:value "ServiceRequest.reasonCode" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.reasonCode" ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "preferred" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "https://terminologia.saude.gov.br/fhir/ValueSet/BRCID10" ;
           fhir:link <https://terminologia.saude.gov.br/fhir/ValueSet/BRCID10>
         ]
       ]
     ], [
       fhir:index 18 ;
       fhir:Element.id [ fhir:value "ServiceRequest.reasonReference" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.reasonReference" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Aceita Condition, Observation, DiagnosticReport ou DocumentReference, como no BR-Core. No RIRA estava restrito a um único BRCID10Avaliado (1..1)." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ], [
       fhir:index 19 ;
       fhir:Element.id [ fhir:value "ServiceRequest.insurance" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.insurance" ] ;
       fhir:ElementDefinition.comment [ fhir:value "No SUS PODE apontar para a Coverage que representa o arranjo público responsável. Não representa o direito universal e NÃO DEVE bloquear o pedido." ]
     ], [
       fhir:index 20 ;
       fhir:Element.id [ fhir:value "ServiceRequest.supportingInfo" ] ;
       fhir:ElementDefinition.path [ fhir:value "ServiceRequest.supportingInfo" ] ;
       fhir:ElementDefinition.comment [ fhir:value "Observações, laudos, fragilidade e terapias prévias. Referências estruturadas antes de anexos." ] ;
       fhir:ElementDefinition.mustSupport [ fhir:value "true"^^xsd:boolean ]
     ]
  ] .

