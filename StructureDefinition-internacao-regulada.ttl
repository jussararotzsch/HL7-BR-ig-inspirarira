  fhir:StructureDefinition.differential [
     fhir:StructureDefinition.differential.element [
       fhir:index 0 ;
       fhir:Element.id [ fhir:value "Encounter" ] ;
       fhir:ElementDefinition.path [ fhir:value "Encounter" ] ;
       fhir:ElementDefinition.short [ fhir:value "Internação Regulada" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Reserva e ocupação de leito resultante da regulação. Reserva = status planned com o leito em location.status reserved. Internação = in-progress com o leito active. Transferência interna (entre leitos do mesmo estabelecimento) é a troca de location dentro do mesmo Encounter. Transferência externa encerra este Encounter (desfecho Transferência) e abre outro no destino, regulado por nova Requisição." ] ;
       fhir:ElementDefinition.constraint [
         fhir:index 0 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "in-1" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Internação planejada (reserva) DEVE ter um leito com location.status = reserved." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "status = 'planned' implies location.where(status = 'reserved').exists()" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://fhir.hsl.org.br/ig/inspirarira/StructureDefinition/internacao-regulada" ;
           fhir:link <http://fhir.hsl.org.br/ig/inspirarira/StructureDefinition/internacao-regulada>
         ]
       ], [
         fhir:index 1 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "in-2" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Internação em curso DEVE ter exatamente um leito ativo." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "status = 'in-progress' implies location.where(status = 'active').count() = 1" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://fhir.hsl.org.br/ig/inspirarira/StructureDefinition/internacao-regulada" ;
           fhir:link <http://fhir.hsl.org.br/ig/inspirarira/StructureDefinition/internacao-regulada>
         ]
       ], [
         fhir:index 2 ;
         fhir:ElementDefinition.constraint.key [ fhir:value "in-3" ] ;
         fhir:ElementDefinition.constraint.severity [ fhir:value "error" ] ;
         fhir:ElementDefinition.constraint.human [ fhir:value "Internação encerrada DEVE informar o desfecho." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "status = 'finished' implies hospitalization.dischargeDisposition.coding.exists()" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "http://fhir.hsl.org.br/ig/inspirarira/StructureDefinition/internacao-regulada" ;
           fhir:link <http://fhir.hsl.org.br/ig/inspirarira/StructureDefinition/internacao-regulada>
         ]
       ]
